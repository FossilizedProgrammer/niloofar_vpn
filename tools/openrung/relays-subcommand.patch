+// runRelays dumps the broker's usable relay directory in the engine's own
+// ranked order (the same TCP-latency ranking the connect ladder walks) as one
+// JSON line, so a host UI can present a user-selectable server list with
+// per-relay probe latency. Each element is a connectcore.DirectoryRelay:
+// {"Relay": <brokerapi.RelayDescriptor>, "ProbeMS": <int64|null>}. Logs and
+// diagnostics go to stderr; stdout carries only the marker line.
+func runRelays(args []string) error {
+	cfg, err := parseCommonFlags("relays", args)
+	if err != nil {
+		return err
+	}
+	host := newEngineHost(newConsoleSink(os.Stderr), "", false)
+	ranked, err := host.engine.RankedDirectory(context.Background(), cfg.BrokerURL)
+	if err != nil {
+		return err
+	}
+	payload, err := json.Marshal(ranked)
+	if err != nil {
+		return err
+	}
+	fmt.Fprintf(os.Stdout, "%s %s\n", relaysJSONMarker, payload)
+	return nil
+}
+
