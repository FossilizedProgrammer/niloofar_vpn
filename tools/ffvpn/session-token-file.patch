+// readSessionFile returns the cached session, or nil when there is none yet. A
+// file holding a stale or malformed token is treated the same way so that the
+// login path can replace it.
+func readSessionFile(path string) (*fxa.Session, error) {
+	if path == "" {
+		return nil, nil
+	}
+	data, err := os.ReadFile(path)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, fmt.Errorf("reading session token file: %w", err)
+	}
+	token := strings.TrimSpace(string(data))
+	if token == "" {
+		return nil, nil
+	}
+	if _, err := fxa.SessionAuthHeader(token); err != nil {
+		log.Printf("%s does not hold a session token (%v); signing in again", path, err)
+		return nil, nil
+	}
+	return &fxa.Session{Token: token, Verified: true}, nil
