--- a/internal/netx/netx.go
+++ b/internal/netx/netx.go
@@ -0,0 +1,29 @@
+// Package netx builds the HTTP clients used to reach the account side.
+package netx
+
+import (
+	"net/http"
+	"net/http/cookiejar"
+	"time"
+)
+
+// Client returns a client that keeps trying through a slow TLS handshake.
+// http.DefaultTransport gives up on the handshake after 10 seconds whatever
+// the client timeout says, and on a congested or filtered link the first
+// handshake to the auth servers regularly takes longer than that, so every
+// connect dies with "net/http: TLS handshake timeout" before the account is
+// even checked. The handshake and the response header get the same budget as
+// the request itself. jar (nil for clients that need no cookies) is installed
+// as the client's cookie jar.
+func Client(timeout time.Duration, jar *cookiejar.Jar) *http.Client {
+	transport := http.DefaultTransport.(*http.Transport).Clone()
+	transport.TLSHandshakeTimeout = timeout
+	transport.ResponseHeaderTimeout = timeout
+	client := &http.Client{Timeout: timeout, Transport: transport}
+	// Jar is an interface field: a typed-nil *cookiejar.Jar would panic the
+	// first request, so it is left unset unless there is a real jar.
+	if jar != nil {
+		client.Jar = jar
+	}
+	return client
+}
