+// serverMarker prefixes one machine-readable server record. The Android client
+// reads these to probe the list for reachability and then dials the winner with
+// --server, so the address has to be exactly what this engine would connect to.
+const serverMarker = "FFVPN_SERVER_JSON "
+
+// printServers writes one marked line per connectable server address.
+func printServers(countries []servers.Country) {
+	for _, c := range countries {
+		if c.Code == "REC" {
+			continue
+		}
+		for _, city := range c.Cities {
+			for i := range city.Servers {
+				addr, err := city.Servers[i].ConnectHostPort()
+				if err != nil {
+					continue
+				}
+				payload, err := json.Marshal(map[string]any{
+					"cc": c.Code, "country": c.Name, "city": city.Name, "addr": addr,
+				})
+				if err != nil {
+					continue
+				}
+				fmt.Printf("%s%s\n", serverMarker, payload)
+			}
+		}
+	}
+}
